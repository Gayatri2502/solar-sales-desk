# Frontend (public values only); defaults to a synthetic browser-local demo.
VITE_MODE=demo
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
VITE_API_URL=http://localhost:8787
# Worker values go in ignored .dev.vars locally, or wrangler secrets in production.
# NEVER prefix these secrets with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER-ONLY-PLACEHOLDER
OPENAI_API_KEY=SERVER-ONLY-PLACEHOLDER
AI_PROVIDER=mock
AI_ENABLED=false
AI_MODEL=gpt-5.4-nano
AI_INPUT_USD_PER_M=0.20
AI_OUTPUT_USD_PER_M=1.25
APP_SPEND_CEILING_USD=5
ALLOWED_ORIGIN=http://localhost:5173
# Optional server-only invoice delivery. Disabled until operator approval/configuration.
INVOICE_EMAIL_ENABLED=false
RESEND_API_KEY=SERVER-ONLY-PLACEHOLDER
INVOICE_FROM_EMAIL=invoices@YOUR-VERIFIED-DOMAIN.example
# Published operator contact (public, optional). Set a real support address before launch.
VITE_SUPPORT_EMAIL=
# Proposed integrations. No outbound request is enabled by placeholders.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=SERVER-ONLY-PLACEHOLDER
WHATSAPP_APP_SECRET=SERVER-ONLY-PLACEHOLDER
WHATSAPP_VERIFY_TOKEN=SERVER-ONLY-PLACEHOLDER
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_QUALIFICATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
VOICE_ENABLED=false
VAPI_API_KEY=SERVER-ONLY-PLACEHOLDER
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=SERVER-ONLY-PLACEHOLDER
VOICE_MAX_SECONDS=180
# Bind the initial provider account to exactly one business in the shared DB.
INTEGRATIONS_TENANT_ID=
# Conservative estimates in INR paise; configure using the agreed account rates.
WHATSAPP_TEMPLATE_ESTIMATE_INR_MINOR=
VOICE_ESTIMATE_INR_PER_MINUTE_MINOR=
# Set true only after reviewing assistant disclosure, consent, and product guardrails.
VAPI_ASSISTANT_REVIEWED=false
# Optional Firebase backend (paired frontend and Worker configuration required)
VITE_AUTH_PROVIDER=supabase
VITE_FIREBASE_API_KEY=YOUR-PUBLIC-FIREBASE-WEB-KEY
VITE_FIREBASE_AUTH_DOMAIN=solar-sales-desk-20261012.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=solar-sales-desk-20261012
VITE_FIREBASE_APP_ID=1:594920646696:web:742653b802e78d369f2d1d
DATABASE_PROVIDER=supabase
FIREBASE_PROJECT_ID=solar-sales-desk-20261012
FIREBASE_DATABASE_ID=sales-native
FIREBASE_SERVICE_ACCOUNT_EMAIL=
FIREBASE_PRIVATE_KEY=SERVER-ONLY-PLACEHOLDER
# Same public Firebase web API key, used server-side to check active/revoked accounts.
FIREBASE_WEB_API_KEY=YOUR-PUBLIC-FIREBASE-WEB-KEY
